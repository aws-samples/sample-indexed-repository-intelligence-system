#
# Amazon Bedrock AgentCore Runtime image for IRIS (S3 index-delivery mode).
#
# Like backend/Dockerfile_s3 (downloads the codebase + pre-generated representation
# from S3 at container start), but runs the AgentCore Runtime entrypoint
# (agent_runtime.py) on port 8080 instead of the WebSocket server on 8000.
# AgentCore Runtime requires ARM64 images.
FROM public.ecr.aws/docker/library/python:3.13-slim-bookworm

RUN pip install uv

WORKDIR /app

# Copy entire project
COPY . ./iris
RUN rm -rf ./iris/.venv

# Install system dependencies and upgrade all packages for security
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    curl \
    git \
    unzip \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Install AWS CLI v2 from official source (architecture-aware)
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        AWS_CLI_ARCH="x86_64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        AWS_CLI_ARCH="aarch64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-${AWS_CLI_ARCH}.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws

RUN apt-get update && apt-get install -y \
    libpam-modules \
    libpam0g \
    libglib2.0-0 \
    libglib2.0-data \
    gnupg2 \
    libxml2 \
    openssl \
    libssl3 \
    libexpat1 \
    libgnutls30 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Environment variables for S3 (populated by the AgentCore Runtime env config)
ENV S3_BUCKET=""
ENV S3_PREFIX=""

WORKDIR /app/iris

# Use the Docker config
RUN rm -f config.yaml && mv config_docker.yaml config.yaml

# Install dependencies using uv
ENV UV_HTTP_TIMEOUT=300
RUN uv sync --frozen --no-dev --no-cache

# Upgrade zipp and urllib3 to fix vulnerabilities
RUN uv pip install --system --upgrade zipp "urllib3>=2.2.3"

# Prepare the AgentCore S3 startup script (while still root)
WORKDIR /app/iris/backend
COPY backend/startup-s3-agentcore.sh ./startup-s3-agentcore.sh
RUN chmod +x ./startup-s3-agentcore.sh

# Create non-root user with home directory
RUN groupadd -r appuser && useradd -r -g appuser -m appuser
RUN mkdir -p /app/codebase_data/output && chown -R appuser:appuser /app
USER appuser

# Set environment variables
ENV PYTHONPATH=/app/iris
ENV PYTHONUNBUFFERED=1
ENV DOCKER_CONTAINER=true

# AgentCore Runtime HTTP protocol contract: POST /invocations + GET /ping on 8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/ping || exit 1

# Download artifacts from S3, then launch the AgentCore Runtime entrypoint
CMD ["./startup-s3-agentcore.sh"]
